# Copie ce fichier en « .env » puis remplace les valeurs.
# Elles se trouvent dans Supabase → ton projet → Settings → API.
#
# Le préfixe EXPO_PUBLIC_ est obligatoire pour qu'Expo expose
# la variable au code de l'application.
#
# La clé « anon » est une clé publique : elle est embarquée dans
# l'app et c'est normal. Ce sont les règles RLS définies dans
# supabase/schema.sql qui empêchent un compte de lire les données
# d'un autre.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
